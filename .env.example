HOST=127.0.0.1
PORT=3000
# Create a Google Web application OAuth client with this redirect URI:
# http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Hosted deployment settings (see README.md):
# HOST=0.0.0.0
# PUBLIC_ORIGIN=https://mail.your-domain.com
# DATA_DIR=/var/lib/mail-studio

# Optional local-only mode to open a campaign from before Firebase sign-in:
# MAIL_STUDIO_LOCAL_OWNER=1
